# shellcheck shell=dash

main(){
    local x_cmd_repkg_branch="main"
    x cd "$(x wsroot)"
    (
        x:info "prepare x-cmd/repkg $x_cmd_repkg_branch"
        git clone git@github.com:x-cmd/repkg.git .tmp/repkg -b "$x_cmd_repkg_branch"
    ) || return 1

    x:info "prepare done"
}

main "$@" || {
    x:info "Use main function failed"
    return 1
}
